# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ─── Doctor slug ──────────────────────────────────────────────────────────────
# Slug of the doctor row (from the `doctors` table) shown on the homepage.
# Defaults to "demo" which renders bundled placeholder data if unset.
NEXT_PUBLIC_DEFAULT_DOCTOR_SLUG=demo

# ─── App URL (required for SMS confirmation link) ─────────────────────────────
# The public URL of your deployed app — used to build the link sent in SMS.
# On Vercel this is your production URL, e.g. https://your-app.vercel.app
# During local development you can use your ngrok URL.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── Twilio SMS ────────────────────────────────────────────────────────────────
# Sign up free at https://twilio.com  (free trial includes ~$15 credit)
# Account SID and Auth Token: Twilio Console → Dashboard
# From number: Twilio Console → Phone Numbers → Active Numbers
#   - For Indian +91 delivery use a Twilio alphanumeric sender ID or a
#     registered +91 number. See README for India DLT registration note.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
